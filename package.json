{
  "name": "skill-maps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mapa de aprendizagem e desenvolvimento profissional.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive build",
    "ci": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm contract:validate && corepack pnpm test && corepack pnpm build",
    "contract:breaking": "openapi-diff",
    "contract:check": "corepack pnpm contract:validate && corepack pnpm contract:generate",
    "contract:generate": "corepack pnpm --filter @skill-maps/api-contract generate",
    "contract:sync": "corepack pnpm --filter @skill-maps/api-contract sync",
    "contract:validate": "corepack pnpm --filter @skill-maps/api-contract validate",
    "db:seed:mvp": "corepack pnpm --filter @skill-maps/api exec tsx --env-file=.env ../../database/seeds/mvp-catalog.ts",
    "db:migrate": "corepack pnpm --filter @skill-maps/api migrate",
    "dev": "corepack pnpm --parallel --filter @skill-maps/api --filter @skill-maps/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "corepack pnpm --recursive test",
    "test:a11y": "playwright test tests/e2e/accessibility-responsive.spec.ts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:critical": "playwright test --project=chromium-desktop",
    "test:integration": "corepack pnpm --filter @skill-maps/api exec vitest run tests/integration",
    "test:load": "node scripts/run-k6.mjs",
    "test:load:inspect": "node scripts/run-k6.mjs inspect",
    "test:unit": "corepack pnpm --filter @skill-maps/api exec vitest run tests/unit",
    "typecheck": "corepack pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "2.49.0",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.11"
  }
}
